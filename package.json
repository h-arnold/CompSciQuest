{
  "name": "compsciquest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static Zork-style text adventure game for GitHub Pages",
  "scripts": {
    "dev": "vite",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "node tools/content/cli.ts validate",
    "content:scaffold": "node tools/content/cli.ts scaffold",
    "content:generate": "node tools/content/cli.ts generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
