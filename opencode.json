{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "content-editor",
  "permissions": [
    { "action": "edit", "resource": "eslint.config.*", "effect": "ask" },
    { "action": "edit", "resource": "tsconfig*.json", "effect": "ask" }
  ],
  "agents": {
    "content-editor": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "area-writer", "effect": "allow" },
        { "action": "subagent", "resource": "npc-writer", "effect": "allow" },
        { "action": "subagent", "resource": "quiz-writer", "effect": "allow" },
        { "action": "subagent", "resource": "puzzle-writer", "effect": "allow" },
        { "action": "subagent", "resource": "hazard-writer", "effect": "allow" },
        { "action": "subagent", "resource": "hint-writer", "effect": "allow" },
        { "action": "subagent", "resource": "content-critic", "effect": "allow" },
        { "action": "subagent", "resource": "pck-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "browser-tester", "effect": "allow" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "graphify-local": {
        "type": "local",
        "command": [
          "graphify-mcp",
          "/workspaces/CompSciQuest/graphify-out/graph.json"
        ]
      },
      "coverage-local": {
        "type": "local",
        "command": [
          "graphify-mcp",
          "/workspaces/CompSciQuest/docs/graphify-out/graph.json"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "playwright-mcp"
        ]
      }
    }
  }
}