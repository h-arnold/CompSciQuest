{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "content-editor",
  "experimental": {
    "subagent_depth": 2
  },
  "permissions": [
    { "action": "edit", "resource": "eslint.config.*", "effect": "ask" },
    { "action": "edit", "resource": "tsconfig*.json", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "graphify-local": {
        "type": "local",
        "command": [
          "graphify-mcp",
          "/workspaces/CompSciQuest/graphify-out/graph.json"
        ]
      },
      "coverage-local": {
        "type": "local",
        "command": [
          "graphify-mcp",
          "/workspaces/CompSciQuest/docs/graphify-out/graph.json"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "playwright-mcp",
          "--no-sandbox",
          "--headless",
          "--browser",
          "chromium"
        ]
      }
    }
  }
}